# Supabase の Project Settings > API からコピー（anon キーは公開前提の値。service_role キーは絶対に入れない）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# 利用を許可するメールアドレス（カンマ区切り）。空なら全ログインユーザーが文字起こしAPIを使えます。
ALLOWED_EMAILS=

# GitHub Pagesなど別ドメインの画面から使う場合に許可するオリジン（カンマ区切り、末尾の / は不要）
# 例: https://raiankun.github.io
ALLOWED_ORIGINS=

# 文字起こしモデル: tiny / base / small / medium / large-v3（大きいほど高精度で重い）
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ja

# アップロード上限(MB)
MAX_UPLOAD_MB=100
